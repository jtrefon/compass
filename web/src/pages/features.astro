---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductShot from "../components/ProductShot.astro";
import { BASE_URL, REPO, RELEASES, FEATURES_SHIPPING, FEATURES_BETA } from "../consts";
---

<BaseLayout
  title="Features: Compass"
  description="Everything Compass does: on-device FIM completion, private local chat, ANE-accelerated RAG, agentic coding with your own provider and keys, in a ~200MB native macOS app."
  canonical={`${BASE_URL}/features`}
>
  <section class="page-hero">
    <div class="container container-narrow">
      <p class="section-kicker reveal">Features</p>
      <h1 class="reveal">Everything you need. Nothing you tolerate.</h1>
      <p class="reveal" style="font-size:1.05rem;color:var(--text-dim);max-width:620px;line-height:1.7">
        The AI editor you actually wanted: agentic power on your terms, private intelligence on your
        machine, and performance that feels native, because it is.
      </p>
    </div>
  </section>

  <section class="section section-alt" style="padding-top:0">
    <div class="container">
      <div class="grid-2" style="align-items:center;gap:40px">
        <div class="reveal">
          <p class="section-kicker">Real AI, on your machine</p>
          <h2 class="section-title" style="font-size:clamp(1.5rem,3vw,2.1rem)">Completion that's actually intelligent.</h2>
          <p style="color:var(--text-dim);line-height:1.75;margin-top:12px">
            Ghost-text completion in <strong>&lt;100ms</strong> from a <strong>4B on-device model</strong>:
            genuine intelligence, not a fake heuristic. Retrieval runs on the <strong>Apple Neural Engine</strong>,
            so indexing and search stay silent and painless while you keep typing.
          </p>
          <p style="color:var(--text-dim);line-height:1.75;margin-top:12px">
            Offline? Still works. Plane, tunnel, coffee shop: your AI doesn't quit because it never
            needed the network.
          </p>
        </div>
        <div class="reveal">
          <ProductShot
            src={`${BASE_URL}/images/shot-completion.webp`}
            alt="Inline ghost-text completion appearing as you type in Compass"
            width={856}
            height={336}
            caption="Sub-100ms ghost-text completion from the on-device model."
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-kicker reveal">Capabilities</p>
      <h2 class="section-title reveal">In the current build</h2>
      <div class="grid-3" style="margin-top:28px">
        {FEATURES_SHIPPING.map((f) => (
          <article class="capability-card reveal">
            <h3><span class="badge badge-live">Live</span>{f.title}</h3>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
      <div style="margin-top:48px">
        <p class="section-kicker reveal">Next up</p>
        <h2 class="section-title reveal" style="font-size:clamp(1.3rem,2.5vw,1.75rem)">On the roadmap, in the open</h2>
        <div class="grid-3" style="margin-top:20px">
          {FEATURES_BETA.map((f) => (
            <article class="capability-card reveal">
              <h3><span class="badge badge-beta">Next</span>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="section-kicker reveal">Native to the core</p>
      <h2 class="section-title reveal">Built for the silicon it runs on.</h2>
      <div class="grid-3" style="margin-top:28px">
        <div class="card reveal">
          <h3 style="color:var(--accent);margin-bottom:8px">~200 MB. AI included.</h3>
          <p style="font-size:.9rem;color:var(--text-dim)">The whole app, with every AI capability on, fits in roughly 200&nbsp;MB. Smaller than most editors with AI turned off.</p>
        </div>
        <div class="card reveal">
          <h3 style="color:var(--accent);margin-bottom:8px">No Electron tax</h3>
          <p style="font-size:.9rem;color:var(--text-dim)">A real macOS binary in Swift. No Chromium, no event loop burning your CPU, no gigabytes of JavaScript in RAM.</p>
        </div>
        <div class="card reveal">
          <h3 style="color:var(--accent);margin-bottom:8px">Liquid Glass &amp; deep OS access</h3>
          <p style="font-size:.9rem;color:var(--text-dim)">Full low-level Apple OS features, including the latest Liquid Glass framework, something a web wrapper can never touch.</p>
        </div>
        <div class="card reveal">
          <h3 style="color:var(--accent);margin-bottom:8px">Built-in terminal &amp; browser</h3>
          <p style="font-size:.9rem;color:var(--text-dim)">Run commands and read docs without leaving the editor. One app, zero context-switching.</p>
        </div>
        <div class="card reveal">
          <h3 style="color:var(--accent);margin-bottom:8px">Private local chat</h3>
          <p style="font-size:.9rem;color:var(--text-dim)">MLX-backed models run chat, quick actions, and inline completion on your Mac. Offline. Private. No API key required.</p>
        </div>
        <div class="card reveal">
          <h3 style="color:var(--accent);margin-bottom:8px">Bring your own provider</h3>
          <p style="font-size:.9rem;color:var(--text-dim)">Route agentic work through OpenRouter, Kilo, DeepSeek, Alibaba, or any OpenAI-compatible endpoint. Your key, your bill.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <p class="section-kicker reveal">Honest about what it isn't</p>
      <h2 class="section-title reveal">What Compass is not</h2>
      <p style="color:var(--text-dim);line-height:1.8;font-size:.95rem">
        Compass is not a Linux editor, not a Windows editor, and not an enterprise procurement
        product, not yet anyway. It's not a cloud-only SaaS, and it's not a browser pretending to
        be an app. We'd rather be the best native AI IDE for macOS than a mediocre one everywhere.
        If that's not your setup, no hard feelings. Come back when Apple Silicon is.
      </p>
    </div>
  </section>

  <section class="section section-alt" style="text-align:center">
    <div class="container container-narrow">
      <h2 class="section-title reveal" style="font-size:1.5rem">Try it. It's free, really.</h2>
      <p class="section-sub reveal" style="margin:0 auto 28px">
        MIT open source. No account, no trial, no credit card. Requires Apple Silicon and macOS 26+.
      </p>
      <div class="reveal" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href={`${BASE_URL}/download`}>Download Compass</a>
        <a class="btn btn-secondary" href={`${REPO}`} target="_blank" rel="noreferrer">View source</a>
      </div>
    </div>
  </section>
</BaseLayout>
