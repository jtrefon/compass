---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BASE_URL, REPO } from "../consts";
---

<BaseLayout
  title="Contributors: Compass"
  description="Build the future of native macOS AI development. Compass is MIT-licensed Swift. Contribute to the editor, the MLX pipeline, or the agent harness."
  canonical={`${BASE_URL}/contributors`}
>
  <section class="page-hero" style="text-align:center">
    <div class="container container-narrow">
      <p class="section-kicker reveal">Open source</p>
      <h1 class="reveal">For contributors</h1>
      <p class="reveal" style="font-size:1.05rem;color:var(--text-dim);max-width:560px;margin:0 auto;line-height:1.7">
        Compass is MIT-licensed and built entirely in Swift. If you want to shape how native AI
        development works on macOS, or just want a project that tests its AI with AI, this is the
        place.
      </p>
      <div class="reveal" style="margin-top:20px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noreferrer">Contribution guide</a>
        <a class="btn btn-secondary" href={`${REPO}/issues`} target="_blank" rel="noreferrer">Open issues</a>
        <a class="btn btn-secondary" href={REPO} target="_blank" rel="noreferrer">GitHub</a>
      </div>
      <div class="reveal" style="margin-top:16px;display:flex;gap:24px;justify-content:center;flex-wrap:wrap;font-size:.85rem">
        <a href={`${REPO}/discussions`} target="_blank" rel="noreferrer" style="color:var(--accent);text-decoration:underline">GitHub Discussions</a>
        <a href={`${REPO}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`} target="_blank" rel="noreferrer" style="color:var(--accent);text-decoration:underline">Good first issues</a>
        <a href={`${REPO}/blob/main/CODE_OF_CONDUCT.md`} target="_blank" rel="noreferrer" style="color:var(--accent);text-decoration:underline">Code of Conduct</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" style="padding-top:0">
    <div class="container container-narrow">
      <div class="grid-2" style="gap:24px">
        <div class="card reveal">
          <h3 style="font-size:1rem;margin-bottom:8px;color:var(--cyan)">Codebase</h3>
          <p style="font-size:.88rem;color:var(--text-dim);line-height:1.7">
            ~40,000 lines of Swift across <code>compass/</code>, the harness tests, and the UI layer.
            Build with Xcode 26+ on Apple Silicon. The project uses <code>xcodebuild</code> (not
            SwiftPM) for the main target, with SPM packages for <code>SyntaxHighlighting</code>
            (tree-sitter) and <code>Terminal</code>.
          </p>
          <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
            <span class="badge badge-live">SwiftUI</span>
            <span class="badge badge-live">AppKit</span>
            <span class="badge badge-live">MLX</span>
            <span class="badge badge-live">FAISS</span>
            <span class="badge badge-live">SQLite</span>
            <span class="badge badge-live">Tree-sitter</span>
          </div>
        </div>
        <div class="card reveal">
          <h3 style="font-size:1rem;margin-bottom:8px;color:var(--violet)">Get started</h3>
          <pre style="font-family:var(--font-mono);font-size:.82rem;background:var(--bg);padding:16px;border-radius:8px;overflow-x:auto;color:var(--text-dim);line-height:1.8">./run.sh build
./run.sh test
./run.sh harness</pre>
          <p style="font-size:.85rem;color:var(--text-faint);margin-top:8px">
            See <code>AGENTS.md</code> and <code>ARCHITECTURE.md</code> in the repo. Everything runs
            from <code>./run.sh</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <h2 class="reveal" style="font-size:1.3rem;margin-bottom:20px;font-weight:600">Where to start</h2>
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="reveal card">
          <h3 style="font-size:.95rem;margin-bottom:4px">Two-pipeline isolation</h3>
          <p style="font-size:.85rem;color:var(--text-dim)">The core architecture: local (4B MLX, no orchestration) and cloud (orchestration graph, 20+ tools). They share zero AI execution code.</p>
          <code style="margin-top:8px;display:inline-block">compass/Services/LocalPipeline/ · compass/Services/CloudPipeline/</code>
        </div>
        <div class="reveal card">
          <h3 style="font-size:.95rem;margin-bottom:4px">Codebase index</h3>
          <p style="font-size:.85rem;color:var(--text-dim)">SQLite index for symbols, chunks, and files, with HNSW-backed embedding retrieval. All in <code>compass/Services/Index/</code>.</p>
          <code style="margin-top:8px;display:inline-block">compass/Services/Index/DatabaseManager.swift</code>
        </div>
        <div class="reveal card">
          <h3 style="font-size:.95rem;margin-bottom:4px">Inline completion engine</h3>
          <p style="font-size:.85rem;color:var(--text-dim)">Local FIM completion with ghost-text rendering, caching, ranking, and sub-100ms latency. The tightest latency loop in the app.</p>
          <code style="margin-top:8px;display:inline-block">compass/Services/LocalPipeline/InlineCompletionEngine.swift</code>
        </div>
        <div class="reveal card">
          <h3 style="font-size:.95rem;margin-bottom:4px">Agent tool system</h3>
          <p style="font-size:.85rem;color:var(--text-dim)">20+ tools implementing the <code>AITool</code> protocol. The tool loop runs in <code>ToolLoopHandler.swift</code> with stall detection.</p>
          <code style="margin-top:8px;display:inline-block">compass/Services/Tools/ · compass/Services/CloudPipeline/ToolLoopHandler.swift</code>
        </div>
        <div class="reveal card">
          <h3 style="font-size:.95rem;margin-bottom:4px">The harness: our AI tests AI</h3>
          <p style="font-size:.85rem;color:var(--text-dim)">
            Compass ships a headless integration harness that runs real agentic tasks through the
            real pipeline and validates the outcome: no mocks, no stubs. When your PR touches the
            agent, the agent gets tested by agents. Few projects can say that.
          </p>
          <code style="margin-top:8px;display:inline-block">compassHarnessTests/ · ./run.sh harness</code>
        </div>
      </div>
      <div class="reveal" style="margin-top:32px;text-align:center">
        <p style="color:var(--text-dim)">
          For full architecture docs, read <a href={`${REPO}/blob/main/ARCHITECTURE.md`} style="color:var(--accent);text-decoration:underline">ARCHITECTURE.md</a>
          and <a href={`${REPO}/blob/main/FEATURES.md`} style="color:var(--accent);text-decoration:underline">FEATURES.md</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt" style="text-align:center">
    <div class="container container-narrow">
      <h2 class="section-title reveal" style="font-size:1.4rem">Your first PR starts here</h2>
      <p class="section-sub reveal" style="margin:0 auto 24px">
        Pick a good first issue, open a Discussion with your idea, or clone the repo and start
        exploring. Every contributor starts somewhere, and the roadmap is decided in the open.
      </p>
      <div class="reveal" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href={`${REPO}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`} target="_blank" rel="noreferrer">Find a good first issue</a>
        <a class="btn btn-secondary" href={`${REPO}/discussions`} target="_blank" rel="noreferrer">Join the Discussion</a>
        <a class="btn btn-secondary" href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noreferrer">Read the guide</a>
      </div>
    </div>
  </section>
</BaseLayout>
